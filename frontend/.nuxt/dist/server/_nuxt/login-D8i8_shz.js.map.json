{"file":"login-D8i8_shz.js","mappings":";;;;;;;;;;;;;;;;;;;AAMkB,iBAAA;AACH,cAAA;AAEf,UAAM,OAAO,SAAS,EAAE,OAAO,IAAI,UAAU,IAAI;AACjD,UAAM,UAAU,IAAI,KAAK;AACzB,UAAM,QAAQ,IAAmB,IAAI;;;AAsB9B,YAAA,OAAAA,eAAAC,WAAA,EAAA,OAAM,0DAAsD,MAAA,CAAA,CAAA,oIAAA;UAKvDC,MAAA,KAAA,GAAK;sIAGRA,MAAA,KAAA,CAAK,CAAA,QAAA;AAAA;;;8HAOKC,cAAA,SAAAD,MAAA,IAAA,EAAK,KAAK,wWAUVC,cAAA,SAAAD,MAAA,IAAA,EAAK,QAAQ,qTASbA,MAAA,OAAA,CAAO,IAAA,cAAA;UAGNA,MAAA,OAAA,GAAO;;;;;;;QAUX,IAAG;AAAA,QAAY,OAAM;AAAA,MAAA;yBAA/B,CAEW,GAAAE,QAAAC,UAAA,aAAA;;;;;8BAF4F,iBAEvG;AAAA,YAAA;AAAA;;;;;;QAIU,IAAG;AAAA,QAAe,OAAM;AAAA,MAAA;yBAAlC,CAEW,GAAAD,QAAAC,UAAA,aAAA;;;;;8BAF+E,qBAE1F;AAAA,YAAA;AAAA;;;;;;;;;;;;;;","names":["_ssrRenderAttrs","_mergeProps","_unref","_ssrRenderAttr","_push","_parent"],"sources":["../../../../pages/login.vue"],"sourcesContent":["<script setup lang=\"ts\">\nimport { authService } from '~/services/auth.service'\nimport { useAuthStore } from '~/stores/auth.store'\n\ndefinePageMeta({ layout: 'auth' })\n\nconst authStore = useAuthStore()\nconst router = useRouter()\n\nconst form = reactive({ email: '', password: '' })\nconst loading = ref(false)\nconst error = ref<string | null>(null)\n\nconst handleSubmit = async () => {\n  loading.value = true\n  error.value = null\n  try {\n    const result = await authService.login(form)\n    authStore.setAuth(result)\n    router.push('/dashboard')\n  } catch (err) {\n    error.value = err instanceof Error ? err.message : 'Login failed'\n  } finally {\n    loading.value = false\n  }\n}\n\nonMounted(() => {\n  if (authStore.token) router.replace('/dashboard')\n})\n</script>\n\n<template>\n  <div class=\"bg-slate-900 border border-slate-800 rounded-2xl p-8\">\n    <h2 class=\"text-xl font-bold text-white mb-1\">Welcome back</h2>\n    <p class=\"text-slate-400 text-sm mb-6\">Sign in to your account</p>\n\n    <div\n      v-if=\"error\"\n      class=\"mb-4 px-4 py-3 bg-rose-500/10 border border-rose-500/30 rounded-lg text-rose-400 text-sm\"\n    >\n      {{ error }}\n    </div>\n\n    <form class=\"space-y-4\" @submit.prevent=\"handleSubmit\">\n      <div>\n        <label class=\"block text-slate-300 text-sm font-medium mb-1.5\">Email</label>\n        <input\n          v-model=\"form.email\"\n          type=\"email\"\n          required\n          placeholder=\"you@example.com\"\n          class=\"w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2.5 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition\"\n        />\n      </div>\n      <div>\n        <label class=\"block text-slate-300 text-sm font-medium mb-1.5\">Password</label>\n        <input\n          v-model=\"form.password\"\n          type=\"password\"\n          required\n          placeholder=\"••••••••\"\n          class=\"w-full bg-slate-800 border border-slate-700 rounded-lg px-4 py-2.5 text-white placeholder-slate-500 text-sm focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition\"\n        />\n      </div>\n      <button\n        type=\"submit\"\n        :disabled=\"loading\"\n        class=\"w-full bg-primary-600 hover:bg-primary-500 disabled:opacity-50 disabled:cursor-not-allowed text-white font-semibold py-2.5 px-4 rounded-lg transition-colors text-sm\"\n      >\n        <span v-if=\"loading\" class=\"flex items-center justify-center gap-2\">\n          <span class=\"w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin\" />\n          Signing in...\n        </span>\n        <span v-else>Sign in</span>\n      </button>\n    </form>\n\n    <p class=\"text-slate-400 text-sm text-center mt-6\">\n      No account?\n      <NuxtLink to=\"/register\" class=\"text-primary-400 hover:text-primary-300 font-medium transition-colors\">\n        Register here\n      </NuxtLink>\n    </p>\n    <p class=\"text-slate-500 text-xs text-center mt-2\">\n      Admin?\n      <NuxtLink to=\"/admin/login\" class=\"text-slate-400 hover:text-slate-300 transition-colors\">\n        Go to admin login\n      </NuxtLink>\n    </p>\n  </div>\n</template>\n"],"version":3}